# ==============================================================================
# Enterprise AI Assistant - Docker Compose Environment Configuration
# Copy this file to .env before running docker compose:
#   cp .env.docker.example .env
# ==============================================================================

# --- Active LLM Provider ---
# Options: "mock", "gemini", "openai", "anthropic", "vllm"
LLM_PROVIDER=mock

# --- API Keys (Leave blank if testing with 'mock') ---
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Local vLLM Server (Points to host machine from container) ---
# Linux: http://172.17.0.1:8001/v1 or http://host.docker.internal:8001/v1
# Mac/Windows: http://host.docker.internal:8001/v1
VLLM_BASE_URL=http://host.docker.internal:8001/v1
VLLM_MODEL_NAME=meta-llama/Meta-Llama-3-8B-Instruct

# --- Container Network Endpoints ---
# Managed automatically in docker-compose.yml
BACKEND_URL=http://backend:8000
REDIS_URL=redis://redis:6379/0
CHROMA_PERSIST_DIR=/app/chroma_db

# --- Performance & Reliability ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600
MAX_RETRIES=3
