# ==============================================================================
# Enterprise AI Assistant - Local Environment Configuration (.env)
# Copy this file to .env:
#   cp .env.example .env
# ==============================================================================

# --- Application Metadata ---
PROJECT_NAME="Enterprise AI Assistant"
VERSION=1.0.0
DEBUG=false

# --- Active LLM Provider ---
# Options: "mock" (offline/zero-cost), "gemini", "openai", "anthropic", "vllm"
LLM_PROVIDER=mock

# --- Cloud LLM Provider API Keys ---
# Required only if the corresponding provider is selected
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Local vLLM Inference Engine ---
# Used when LLM_PROVIDER=vllm or as secondary fallback in the resilience chain
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL_NAME=meta-llama/Meta-Llama-3-8B-Instruct

# --- Generation Hyperparameters ---
DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_P=0.95
DEFAULT_MAX_TOKENS=1024

# --- RAG & Vector Database (ChromaDB) ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./chroma_db
RAG_DEFAULT_CHUNK_SIZE=500
RAG_DEFAULT_CHUNK_OVERLAP=100
RAG_DEFAULT_TOP_K=3
RAG_SCORE_THRESHOLD=0.35

# --- Reliability & Fault Tolerance ---
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=1.5
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIME=30

# --- Rate Limiting (Token-Bucket Algorithm) ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# --- Multi-Tier Caching ---
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600
# Optional Redis cache (falls back to In-Memory LRU if empty)
# REDIS_URL=redis://localhost:6379/0

# --- Frontend Connection URL ---
BACKEND_URL=http://localhost:8000
